          "title": "Did the Problem Actually Get Harder? Testing LLMs on Paired P and NP-Complete Problems Hardened by Adversarial Multi-Agent Rewriting",
          "updated_date": "2026-11-07T11:25:07.637180"
        },
        "openalex_target_resolution": {
          "http_status": 200,
          "raw_response_sha256": "eef47f3235a1120808e1cd86f2e99b5ff824d70fbc5653bacba511e421b038fb",
          "referenced_works_ids_sha256": "2744aefac1188981080c31d0325de0bd0bdc3644457b370338124778d5dce71f",
