          "title": "AtomicRL: Atomic Reinforcement Learning for Long-Horizon Robotic Manipulation",
          "updated_date": "2026-11-10T11:39:43.021295"
        },
        "openalex_target_resolution": {
          "http_status": 200,
          "raw_response_sha256": "c43a48f0368d62226a518304e882a1d5789cf2d4736b8b3d2f1e641310c3cf84",
          "referenced_works_ids_sha256": "6a1246deec46eb9f3cbc5c5c93a0134358de675ab8cd277fe43f7823ef3dae8a",
          "request_url": "https://api.openalex.org/works?filter=locations.landing_page_url%3Ahttps%3A%2F%2Farxiv.org%2Fabs%2F2610.30097&per_page=5&select=id%2Cdoi%2Ctitle%2Cpublication_date%2Creferenced_works%2Cids%2Cabstract_inverted_index%2Cupdated_date%2Clocations",
          "retrieved_at_utc": "2026-11-11T09:55:28.782733Z",
