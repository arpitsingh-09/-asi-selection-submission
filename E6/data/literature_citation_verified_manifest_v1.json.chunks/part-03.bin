          "title": "ProactEgoMem: Benchmarking Proactive Memory in Streaming Egocentric Video",
          "updated_date": "2026-11-07T11:25:07.637180"
        },
        "openalex_target_resolution": {
          "http_status": 200,
          "raw_response_sha256": "af85649b3ead14b5bff0e5c125c577a0a21563979781208246dc26fdace9607a",
          "referenced_works_ids_sha256": "8015800f21569be1cabe5cff8f705868c08b2ecd1117b9264974b307e59f35a6",
          "request_url": "https://api.openalex.org/works?filter=locations.landing_page_url%3Ahttps%3A%2F%2Farxiv.org%2Fabs%2F2610.30089&per_page=5&select=id%2Cdoi%2Ctitle%2Cpublication_date%2Creferenced_works%2Cids%2Cabstract_inverted_index%2Cupdated_date%2Clocations",
          "retrieved_at_utc": "2026-11-11T09:55:26.735632Z",
          "source": "OpenAlex",
          "target_openalex_record_sha256": "a40ea2123a1cc1481b2306a063c51c319a2bffbb4cb6679aafefd689e9f0c418",
