{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "M frozen core prediction record v1; see EVALUATION.md for test-specific fields",
  "type": "object",
  "required": ["record_id", "unit_id", "unit_kind", "question_ids", "dataset_kind", "posed_at", "available_at", "model_trained_until", "selected_on", "provenance", "input_versions", "control_evidence", "predictions"],
  "properties": {
    "record_id": {"type": "string"}, "unit_id": {"type": "string"},
    "unit_kind": {"enum": ["focal_question", "paper_pair_component", "focal_paper", "seed_battle_component", "paper", "topic", "seed_component"]},
    "question_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "dataset_kind": {"enum": ["synthetic", "real"]},
    "posed_at": {"type": "string"}, "available_at": {"type": "string"},
    "selected_on": {"const": "2024-validation-only"},
    "input_versions": {"type": "array"},
    "predictions": {"type": "object", "required": ["original", "empty", "shuffled", "decoy"], "additionalProperties": {"type": "object"}},
    "label_evidence": {"type": "object", "required": ["source", "text", "sha256", "observed_at"]}
  }
}
